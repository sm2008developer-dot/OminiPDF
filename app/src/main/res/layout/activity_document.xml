<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_back"
            android:tint="@color/on_surface" />

        <TextView
            android:id="@+id/docName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_edit"
            android:drawablePadding="8dp"
            android:drawableTint="@color/on_surface_variant"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="8dp"
            android:textColor="@color/on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Omini.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/save_label" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_search"
        android:paddingStart="16dp"
        android:paddingTop="5dp"
        android:paddingEnd="16dp"
        android:paddingBottom="5dp"
        android:textColor="@color/on_surface"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_panel"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/btnAddPage"
            style="@style/CropTool">

            <ImageView
                style="@style/CropToolIcon"
                android:src="@drawable/ic_page_add" />

            <TextView
                style="@style/CropToolLabel"
                android:text="@string/add_page" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnEditPage"
            style="@style/CropTool">

            <ImageView
                style="@style/CropToolIcon"
                android:src="@drawable/ic_crop" />

            <TextView
                style="@style/CropToolLabel"
                android:text="@string/edit_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnManage"
            style="@style/CropTool">

            <ImageView
                style="@style/CropToolIcon"
                android:src="@drawable/ic_apps" />

            <TextView
                style="@style/CropToolLabel"
                android:text="@string/manage_pages" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPageSettings"
            style="@style/CropTool">

            <ImageView
                style="@style/CropToolIcon"
                android:src="@drawable/ic_tune" />

            <TextView
                style="@style/CropToolLabel"
                android:text="@string/page_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
